#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
CRASHDIR=/data/ShellCrash
boot() {
    [ -d "$CRASHDIR" ] || return 0
    [ ! -f "$CRASHDIR/.dis_startup" ] && [ ! -f "$CRASHDIR/.start_error" ] || return 0
    start
}
start_service() {
    [ -z "$(pidof CrashCore 2>/dev/null)" ] || return 0
    /usr/libexec/rd03-shellcrash-prepare --ensure || return 1
    [ ! -f "$CRASHDIR/.start_error" ] || return 1
    "$CRASHDIR/starts/bfstart.sh" || return 1
    . "$CRASHDIR/configs/command.env"
    procd_open_instance
    procd_set_param user root
    procd_set_param command $COMMAND
    procd_set_param term_timeout 10
    procd_set_param stderr 0
    procd_set_param stdout 0
    procd_close_instance
    "$CRASHDIR/starts/afstart.sh" &
}
stop_service() {
    "$CRASHDIR/starts/fw_stop.sh"
}
